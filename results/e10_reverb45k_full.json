  "benchmark": "REVERB45K test, CESI protocol (NP canonicalization)",
  "data": {
    "triples": 36814,
    "records_unique_subjects": 12327,
    "gold_clusters": 6061,
    "gold_singletons": 0,
    "limit": 0
